#!/bin/sh

set -eu

if [ -f "$HOME/.config/shell/path.sh" ]; then
    # Align this report with the shared shell bootstrap when present.
    . "$HOME/.config/shell/path.sh"
fi

FORMAT=human

usage() {
    cat <<'EOF'
Usage: scripts/show-dev-env-ubuntu [--json]

Show Ubuntu-focused coding-agent development environment status.

Options:
  --json      Emit machine-readable JSON instead of the default table
  -h, --help  Show this help text
EOF
}

if [ "${1:-}" = "--json" ]; then
    FORMAT=json
    shift
elif [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
    exit 0
fi

if [ "$#" -ne 0 ]; then
    usage >&2
    exit 1
fi

GENERATED_AT=$(date '+%Y-%m-%d %H:%M:%S %Z')
PLAN_SUMMARY='Ubuntu baseline: apt + (optional nala) + mise + direnv + uv + pnpm; prefer podman over docker when container tooling is needed.'

OS_NAME=$(uname -s 2>/dev/null || echo unknown)
DISTRO_ID=unknown
DISTRO_VERSION=unknown
if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    . /etc/os-release
    DISTRO_ID=${ID:-unknown}
    DISTRO_VERSION=${VERSION_ID:-unknown}
fi

is_ubuntu_host() {
    [ "$OS_NAME" = "Linux" ] && [ "$DISTRO_ID" = "ubuntu" ]
}

json_escape() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1], end="")'
    else
        # Best-effort fallback for minimal environments.
        printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
    fi
}

command_path() {
    command -v "$1" 2>/dev/null || true
}

version_for() {
    tool=$1

    case "$tool" in
        apt)
            apt --version | awk 'NR==1 {print $2}'
            ;;
        nala)
            nala --version 2>/dev/null | awk 'NR==1 {print $2}'
            ;;
        snap)
            snap version 2>/dev/null | awk '/^snap[[:space:]]+/ {print $2; exit}'
            ;;
        mise)
            mise --version | awk 'NR==1 {print $1}'
            ;;
        direnv)
            direnv version | awk 'NR==1 {print $1}'
            ;;
        uv)
            uv --version | awk 'NR==1 {print $2}'
            ;;
        node)
            node -v
            ;;
        npm)
            npm -v
            ;;
        pnpm)
            pnpm -v
            ;;
        go)
            go version | awk 'NR==1 {print $3}'
            ;;
        gh)
            gh --version | awk 'NR==1 {print $3}'
            ;;
        rg)
            rg --version | awk 'NR==1 {print $2}'
            ;;
        fd)
            if command -v fd >/dev/null 2>&1; then
                fd --version | awk 'NR==1 {print $2}'
            else
                fdfind --version | awk 'NR==1 {print $2}'
            fi
            ;;
        fzf)
            fzf --version | awk 'NR==1 {print $1}'
            ;;
        just)
            just --version | awk 'NR==1 {print $2}'
            ;;
        git)
            git --version | awk 'NR==1 {print $3}'
            ;;
        codex)
            codex --version 2>/dev/null | awk 'NR==1 {print $2}'
            ;;
        claude)
            claude --version 2>/dev/null | awk 'NR==1 {print $1}'
            ;;
        antigravity)
            antigravity --version 2>/dev/null | awk 'NR==1 {print $1}'
            ;;
        opencode)
            if opencode --version >/dev/null 2>&1; then
                opencode --version 2>/dev/null | awk 'NR==1 {print $NF}'
            elif opencode version >/dev/null 2>&1; then
                opencode version 2>/dev/null | awk 'NR==1 {print $NF}'
            else
                printf 'unknown'
            fi
            ;;
        java)
            java -version 2>&1 | awk -F'"' '/version/ {print $2; exit}'
            ;;
        gradle)
            gradle --version 2>/dev/null | awk '/^Gradle / {print $2; exit}'
            ;;
        mvn)
            mvn -v 2>/dev/null | awk 'NR==1 {print $3}'
            ;;
        podman)
            podman --version 2>/dev/null | awk 'NR==1 {print $3}'
            ;;
        docker)
            docker --version 2>/dev/null | awk -F'[ ,]+' 'NR==1 {print $3}'
            ;;
        *)
            printf ''
            ;;
    esac
}

inspect_tool() {
    tool=$1
    category=$2
    plan=$3
    note=$4

    installed=false
    path=
    version=

    case "$tool" in
        fd)
            path=$(command_path fd)
            if [ -z "$path" ]; then
                path=$(command_path fdfind)
            fi
            if [ -n "$path" ]; then
                installed=true
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
        *)
            path=$(command_path "$tool")
            if [ -n "$path" ]; then
                installed=true
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
    esac

    if [ "$installed" = true ] && [ -z "$version" ]; then
        version='unknown'
    fi

    if [ "$installed" = true ]; then
        case "$plan" in
            future)
                state='installed-future'
                ;;
            keep)
                state='kept'
                ;;
            alternative)
                state='installed-alternative'
                ;;
            *)
                state='installed'
                ;;
        esac
    else
        case "$plan" in
            future)
                state='deferred'
                ;;
            alternative)
                state='optional-missing'
                ;;
            *)
                state='missing'
                ;;
        esac
        path='-'
        version='-'
    fi

    printf '%s|%s|%s|%s|%s|%s|%s\n' "$category" "$plan" "$state" "$tool" "$version" "$path" "$note"
}

collect_records() {
    inspect_tool apt system now 'Default Ubuntu package manager'
    inspect_tool nala system alternative 'Optional apt frontend with better UX'
    inspect_tool snap system alternative 'Optional fallback when apt packages are unavailable'
    inspect_tool mise runtime now 'Cross-language runtime manager'
    inspect_tool direnv runtime now 'Repo-local environment activation'
    inspect_tool uv python keep 'Python runtime and dependency workflow'
    inspect_tool node node now 'Managed by mise'
    inspect_tool npm node keep 'Bundled with Node'
    inspect_tool pnpm node now 'Default JS/TS package manager'
    inspect_tool go go now 'Managed by mise'
    inspect_tool git core keep 'Version control'
    inspect_tool gh core now 'GitHub CLI'
    inspect_tool rg core now 'ripgrep search tool'
    inspect_tool fd core now 'Fast file finder (fd/fdfind)'
    inspect_tool fzf core now 'Fuzzy finder'
    inspect_tool just core now 'Task runner'
    inspect_tool codex agent keep 'OpenAI coding agent'
    inspect_tool claude agent keep 'Anthropic coding agent'
    inspect_tool antigravity agent keep 'Antigravity CLI'
    inspect_tool opencode agent keep 'OpenCode CLI'
    inspect_tool java future future 'Deferred Java runtime'
    inspect_tool gradle future future 'Deferred; prefer project wrapper when needed'
    inspect_tool mvn future future 'Deferred; prefer project wrapper when needed'
    inspect_tool podman future future 'Preferred container runtime on Ubuntu when needed'
    inspect_tool docker future future 'Compatibility option for team/tooling requirements'
}

render_human() {
    printf 'Agentic Dev Env Status (Ubuntu Baseline)\n'
    printf 'Generated: %s\n' "$GENERATED_AT"
    printf 'Host: %s / %s %s\n' "$OS_NAME" "$DISTRO_ID" "$DISTRO_VERSION"
    printf 'Plan-of-record: %s\n' "$PLAN_SUMMARY"
    if ! is_ubuntu_host; then
        printf 'Note: host is not Ubuntu; this report still shows Ubuntu-targeted recommendations.\n'
    fi
    printf '\n'
    printf '%-12s %-20s %-14s %-15s %-48s %s\n' "PLAN" "STATE" "TOOL" "VERSION" "PATH" "NOTE"
    printf '%-12s %-20s %-14s %-15s %-48s %s\n' "------------" "--------------------" "--------------" "---------------" "------------------------------------------------" "------------------------------"

    collect_records | while IFS='|' read -r category plan state tool version path note; do
        printf '%-12s %-20s %-14s %-15s %-48s %s\n' "$plan" "$state" "$tool" "$version" "$path" "$note"
    done
}

render_json() {
    printf '{\n'
    printf '  "target": "ubuntu-linux",\n'
    printf '  "generated_at": "%s",\n' "$(json_escape "$GENERATED_AT")"
    printf '  "plan_of_record": "%s",\n' "$(json_escape "$PLAN_SUMMARY")"
    printf '  "host": {\n'
    printf '    "os_name": "%s",\n' "$(json_escape "$OS_NAME")"
    printf '    "distro_id": "%s",\n' "$(json_escape "$DISTRO_ID")"
    printf '    "distro_version": "%s",\n' "$(json_escape "$DISTRO_VERSION")"
    if is_ubuntu_host; then
        printf '    "is_ubuntu": true\n'
    else
        printf '    "is_ubuntu": false\n'
    fi
    printf '  },\n'
    printf '  "tools": [\n'

    first=true
    collect_records | while IFS='|' read -r category plan state tool version path note; do
        if [ "$first" = true ]; then
            first=false
        else
            printf ',\n'
        fi

        installed=false
        if [ "$state" = "installed" ] || [ "$state" = "kept" ] || [ "$state" = "installed-future" ] || [ "$state" = "installed-alternative" ]; then
            installed=true
        fi

        if [ "$path" = "-" ]; then
            json_path='null'
        else
            json_path=$(printf '"%s"' "$(json_escape "$path")")
        fi

        if [ "$version" = "-" ]; then
            json_version='null'
        else
            json_version=$(printf '"%s"' "$(json_escape "$version")")
        fi

        printf '    {\n'
        printf '      "name": "%s",\n' "$(json_escape "$tool")"
        printf '      "category": "%s",\n' "$(json_escape "$category")"
        printf '      "plan_status": "%s",\n' "$(json_escape "$plan")"
        printf '      "state": "%s",\n' "$(json_escape "$state")"
        printf '      "installed": %s,\n' "$installed"
        printf '      "version": %s,\n' "$json_version"
        printf '      "path": %s,\n' "$json_path"
        printf '      "note": "%s"\n' "$(json_escape "$note")"
        printf '    }'
    done

    printf '\n  ]\n'
    printf '}\n'
}

case "$FORMAT" in
    human)
        render_human
        ;;
    json)
        render_json
        ;;
esac
