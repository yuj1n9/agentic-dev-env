#!/bin/sh

set -eu

# Unified dev env status script for macOS, Ubuntu, and Alibaba Cloud Linux.
# Auto-detects the OS and reports installed tools.

if [ -f "$HOME/.config/shell/path.sh" ]; then
    . "$HOME/.config/shell/path.sh"
fi

FORMAT=human

usage() {
    cat <<'EOF'
Usage: scripts/show-dev-env [--json] [--target <os>]

Show the current coding-agent development environment status.

Options:
  --json          Emit machine-readable JSON instead of the default table
  --target <os>   Force a specific target (macos, ubuntu, alibaba-cloud-linux)
                  Default: auto-detect from the current host
  -h, --help      Show this help text
EOF
}

TARGET=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --json)
            FORMAT=json
            shift
            ;;
        --target)
            if [ -z "${2:-}" ]; then
                echo "Error: --target requires an argument" >&2
                exit 1
            fi
            TARGET="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 1
            ;;
    esac
done

GENERATED_AT=$(date '+%Y-%m-%d %H:%M:%S %Z')

# OS detection
OS_NAME=$(uname -s 2>/dev/null || echo unknown)
DISTRO_ID=unknown
DISTRO_VERSION=unknown

if [ -f /etc/os-release ]; then
    . /etc/os-release
    DISTRO_ID=${ID:-unknown}
    DISTRO_VERSION=${VERSION_ID:-unknown}
fi

detect_target() {
    if [ -n "$TARGET" ]; then
        printf '%s' "$TARGET"
        return
    fi

    case "$OS_NAME" in
        Darwin)
            printf 'macos'
            ;;
        Linux)
            case "$DISTRO_ID" in
                ubuntu)
                    printf 'ubuntu'
                    ;;
                alinux|alibaba-cloud-linux|almalinux|centos|rhel)
                    printf 'alibaba-cloud-linux'
                    ;;
                *)
                    printf 'ubuntu'
                    ;;
            esac
            ;;
        *)
            printf 'unknown'
            ;;
    esac
}

TARGET=$(detect_target)

json_escape() {
    if command -v python3 >/dev/null 2>&1; then
        printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read())[1:-1], end="")'
    else
        printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
    fi
}

command_path() {
    command -v "$1" 2>/dev/null || true
}

app_version() {
    if [ "$OS_NAME" = "Darwin" ]; then
        /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$1/Contents/Info.plist" 2>/dev/null || true
    fi
}

version_for() {
    tool=$1

    case "$tool" in
        brew)
            brew --version | awk 'NR==1 {print $2}'
            ;;
        apt)
            apt --version 2>/dev/null | awk 'NR==1 {print $2}'
            ;;
        dnf)
            dnf --version 2>/dev/null | awk 'NR==1 {print $2}'
            ;;
        mise)
            mise --version | awk 'NR==1 {print $1}'
            ;;
        direnv)
            direnv version | awk 'NR==1 {print $1}'
            ;;
        uv)
            uv --version | awk 'NR==1 {print $2}'
            ;;
        node)
            node -v
            ;;
        npm)
            npm -v
            ;;
        pnpm)
            pnpm -v
            ;;
        go)
            go version | awk 'NR==1 {print $3}'
            ;;
        gh)
            gh --version | awk 'NR==1 {print $3}'
            ;;
        rg)
            rg --version | awk 'NR==1 {print $2}'
            ;;
        fd)
            if command -v fd >/dev/null 2>&1; then
                fd --version | awk 'NR==1 {print $2}'
            elif command -v fdfind >/dev/null 2>&1; then
                fdfind --version | awk 'NR==1 {print $2}'
            fi
            ;;
        fzf)
            fzf --version | awk 'NR==1 {print $1}'
            ;;
        just)
            just --version | awk 'NR==1 {print $2}'
            ;;
        jq)
            jq --version 2>/dev/null | sed 's/^jq-//'
            ;;
        git)
            git --version | awk 'NR==1 {print $3}'
            ;;
        codex)
            codex --version 2>/dev/null | awk 'NR==1 {print $2}'
            ;;
        claude)
            claude --version 2>/dev/null | awk 'NR==1 {print $1}'
            ;;
        antigravity)
            antigravity --version 2>/dev/null | awk 'NR==1 {print $1}'
            ;;
        opencode)
            if opencode --version >/dev/null 2>&1; then
                opencode --version 2>/dev/null | awk 'NR==1 {print $NF}'
            elif opencode version >/dev/null 2>&1; then
                opencode version 2>/dev/null | awk 'NR==1 {print $NF}'
            else
                printf 'unknown'
            fi
            ;;
        java)
            java -version 2>&1 | awk -F'"' '/version/ {print $2; exit}'
            ;;
        gradle)
            gradle --version 2>/dev/null | awk '/^Gradle / {print $2; exit}'
            ;;
        mvn)
            mvn -v 2>/dev/null | awk 'NR==1 {print $3}'
            ;;
        docker)
            docker --version 2>/dev/null | awk -F'[ ,]+' 'NR==1 {print $3}'
            ;;
        orbstack)
            app_version "/Applications/OrbStack.app"
            ;;
        podman)
            podman --version 2>/dev/null | awk 'NR==1 {print $3}'
            ;;
        *)
            printf ''
            ;;
    esac
}

inspect_tool() {
    tool=$1
    category=$2
    note=$3

    installed=false
    path=
    version=

    case "$tool" in
        orbstack)
            if [ -d /Applications/OrbStack.app ]; then
                installed=true
                path=/Applications/OrbStack.app
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
        java)
            if [ "$OS_NAME" = "Darwin" ]; then
                java_home=$(/usr/libexec/java_home 2>/dev/null || true)
            else
                java_home=${JAVA_HOME:-}
            fi
            if [ -n "$java_home" ] && [ -x "$java_home/bin/java" ]; then
                installed=true
                path=$java_home/bin/java
                version=$(version_for "$tool" 2>/dev/null || true)
            elif command -v java >/dev/null 2>&1; then
                installed=true
                path=$(command_path java)
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
        fd)
            path=$(command_path fd)
            if [ -z "$path" ]; then
                path=$(command_path fdfind)
            fi
            if [ -n "$path" ]; then
                installed=true
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
        *)
            path=$(command_path "$tool")
            if [ -n "$path" ]; then
                installed=true
                version=$(version_for "$tool" 2>/dev/null || true)
            fi
            ;;
    esac

    if [ "$installed" = true ] && [ -z "$version" ]; then
        version='unknown'
    fi

    printf '%s|%s|%s|%s|%s\n' "$category" "$tool" "$installed" "$version" "$path"
}

collect_records() {
    # System package manager
    case "$TARGET" in
        macos)  inspect_tool brew system 'Package manager' ;;
        ubuntu) inspect_tool apt system 'Package manager' ;;
        alibaba-cloud-linux) inspect_tool dnf system 'Package manager' ;;
    esac

    # Core runtime stack
    inspect_tool mise runtime 'Runtime manager'
    inspect_tool direnv runtime 'Env activation'
    inspect_tool uv python 'Python toolchain'

    # Node
    inspect_tool node node 'Node runtime'
    inspect_tool npm node 'Node package manager'
    inspect_tool pnpm node 'Package manager'

    # Go
    inspect_tool go go 'Go runtime'

    # Core CLI
    inspect_tool git core 'Version control'
    inspect_tool gh core 'GitHub CLI'
    inspect_tool rg core 'Search'
    inspect_tool fd core 'File finder'
    inspect_tool fzf core 'Fuzzy finder'
    inspect_tool just core 'Task runner'
    inspect_tool jq core 'JSON processor'

    # Agent CLIs
    inspect_tool codex agent 'OpenAI agent'
    inspect_tool claude agent 'Anthropic agent'
    inspect_tool antigravity agent 'Antigravity CLI'
    inspect_tool opencode agent 'OpenCode CLI'

    # Optional/future
    inspect_tool java future 'Java runtime'
    inspect_tool gradle future 'Build tool'
    inspect_tool mvn future 'Build tool'
    inspect_tool docker future 'Container CLI'
    inspect_tool orbstack future 'Container runtime'
    inspect_tool podman future 'Container runtime'
}

render_human() {
    printf 'Dev Env Status\n'
    printf 'Target: %s\n' "$TARGET"
    printf 'Generated: %s\n' "$GENERATED_AT"
    printf 'Host: %s / %s %s\n\n' "$OS_NAME" "$DISTRO_ID" "$DISTRO_VERSION"
    printf '%-12s %-15s %-48s %s\n' "TOOL" "VERSION" "PATH" "NOTE"
    printf '%-12s %-15s %-48s %s\n' "------------" "---------------" "------------------------------------------------" "--------------------"

    collect_records | while IFS='|' read -r category tool installed version path; do
        if [ "$installed" = "true" ]; then
            printf '%-12s %-15s %-48s %s\n' "$tool" "$version" "$path"
        fi
    done
}

render_json() {
    printf '{\n'
    printf '  "target": "%s",\n' "$(json_escape "$TARGET")"
    printf '  "generated_at": "%s",\n' "$(json_escape "$GENERATED_AT")"
    printf '  "host": {\n'
    printf '    "os_name": "%s",\n' "$(json_escape "$OS_NAME")"
    printf '    "distro_id": "%s",\n' "$(json_escape "$DISTRO_ID")"
    printf '    "distro_version": "%s"\n' "$(json_escape "$DISTRO_VERSION")"
    printf '  },\n'
    printf '  "tools": [\n'

    first=true
    collect_records | while IFS='|' read -r category tool installed version path; do
        if [ "$first" = true ]; then
            first=false
        else
            printf ',\n'
        fi

        if [ -z "$path" ]; then
            json_path='null'
        else
            json_path=$(printf '"%s"' "$(json_escape "$path")")
        fi

        if [ -z "$version" ] || [ "$version" = "unknown" ]; then
            json_version='null'
        else
            json_version=$(printf '"%s"' "$(json_escape "$version")")
        fi

        printf '    {\n'
        printf '      "name": "%s",\n' "$(json_escape "$tool")"
        printf '      "category": "%s",\n' "$(json_escape "$category")"
        printf '      "installed": %s,\n' "$installed"
        printf '      "version": %s,\n' "$json_version"
        printf '      "path": %s\n' "$json_path"
        printf '    }'
    done

    printf '\n  ]\n'
    printf '}\n'
}

case "$FORMAT" in
    human) render_human ;;
    json)  render_json ;;
esac